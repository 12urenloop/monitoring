          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH DATA AS (\nSELECT\n   lap.id,\n   lap.team_id,\n   lap.timestamp,\n   COUNT(1) as count -- Creates a column of \"1\" for counting the occurrences\n   FROM lap\n   where lap_source_id=5\n   GROUP BY 1, timestamp, team_id\n)\nSELECT\n   t.name as name,\n   timestamp as time,\n   SUM(count) OVER (PARTITION BY team_id\n                           ORDER BY team_id, timestamp\n                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) as value\nFROM DATA d\nJOIN team t on t.id = d.team_id\nORDER BY time ASC",
          "refId": "A",
          "sql": {
