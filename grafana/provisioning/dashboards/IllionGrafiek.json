        "name": "Laps",
        "target": {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time,\n  round(lap_duration::numeric, 2)::text || 's' AS text,\n  'lap' AS tags\nFROM (\n  SELECT\n    timestamp - interval '2 hour' AS time,\n    extract(epoch from timestamp - LAG(timestamp) OVER (PARTITION BY l.team_id ORDER BY timestamp)) AS lap_duration\n  FROM lap l\n  JOIN team t ON l.team_id = t.id\n  JOIN team_baton_ids tb ON tb.team_id = t.id\n  WHERE tb.baton_id IN ([[baton]])\n    AND lap_source_id = 5\n) sub\nWHERE $__timeFilter(time)\n  AND lap_duration IS NOT NULL",
          "refId": "Anno",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      }
    ]
