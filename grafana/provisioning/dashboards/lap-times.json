      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P153BFFACB2904795"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH lap_durations AS (\n  SELECT\n    l.timestamp,\n    tb.baton_id,\n    team.name as team_name,\n    extract(epoch from l.timestamp - LAG(l.timestamp)\n      OVER (PARTITION BY tb.baton_id ORDER BY l.timestamp)\n    ) AS lap_duration\n  FROM lap l\n  JOIN team_baton_ids tb ON tb.team_id = l.team_id\n  JOIN team ON tb.team_id = team.id\n  WHERE team.name IN ($Teams)\n    AND l.lap_source_id = 5\n),\nnumbered AS (\n  SELECT\n    timestamp,\n    baton_id,\n    team_name,\n    lap_duration,\n    ROW_NUMBER() OVER (PARTITION BY baton_id ORDER BY timestamp) AS rn\n  FROM lap_durations\n  WHERE lap_duration IS NOT NULL\n)\nSELECT\n  $__time(a.timestamp - interval '2 hour'),\n  a.team_name AS metric,\n  (\n    SELECT percentile_cont(0.90) WITHIN GROUP (ORDER BY b.lap_duration)\n    FROM numbered b\n    WHERE b.baton_id = a.baton_id\n      AND b.rn BETWEEN a.rn - 25 AND a.rn\n  ) AS p25_lap_time\nFROM numbered a\nWHERE $__timeFilter(a.timestamp - interval '2 hour')\n  AND a.rn >= 10\nORDER BY a.timestamp",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Who is gaining?",
      "type": "timeseries"
    }
